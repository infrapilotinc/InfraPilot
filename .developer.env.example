# =============================================================
# Developer credentials — registry push tokens (CE)
# =============================================================
# Used ONLY by scripts/build-and-publish.sh to log in before pushing images.
# Copy to .developer.env (gitignored) and fill in. Keep these out of .env.
#
#   cp .developer.env.example .developer.env
#
# CE publishes to BOTH Docker Hub and GHCR, so set all four.

# Docker Hub — access token from hub.docker.com → Account → Security
DOCKERHUB_USERNAME=infrapilothq
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxx

# GHCR — GitHub PAT (classic) with the write:packages scope
GHCR_USERNAME=your-github-username
GHCR_TOKEN=ghp_xxxxxxxxxxxx
