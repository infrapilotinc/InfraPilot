# Agent Development Dockerfile with Hot Reload
FROM golang:1.24-alpine

WORKDIR /app

# Install Air for hot reload (v1.61.0 supports Go 1.24) and Docker CLI
RUN go install github.com/air-verse/air@v1.61.0
RUN apk add --no-cache git docker-cli curl
# nixpacks: build source for push-to-deploy when no Dockerfile is present
ARG NIXPACKS_VERSION=1.41.0
RUN curl -fsSL "https://github.com/railwayapp/nixpacks/releases/download/v${NIXPACKS_VERSION}/nixpacks-v${NIXPACKS_VERSION}-x86_64-unknown-linux-musl.tar.gz" -o /tmp/nixpacks.tar.gz \
    && tar -xzf /tmp/nixpacks.tar.gz -C /usr/local/bin nixpacks \
    && rm /tmp/nixpacks.tar.gz

# Copy go mod files
COPY go.mod go.sum* ./
RUN go mod download

# Air will watch for changes
EXPOSE 9091

CMD ["air", "-c", ".air.toml"]
