# =============================================================
# InfraPilot Environment Variables
# =============================================================
# Copy this file to .env and configure for your environment
#
# SECURITY: Never commit .env files to version control!
# =============================================================

# -------------------------------------------------------------
# REQUIRED VARIABLES
# -------------------------------------------------------------

# JWT Secret (REQUIRED - Generate a secure 32+ character secret)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# Encryption Key (REQUIRED for webhook signatures, registry credentials, SSO)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# -------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------
POSTGRES_USER=infrapilot
POSTGRES_PASSWORD=infrapilot
POSTGRES_DB=infrapilot

# -------------------------------------------------------------
# REDIS
# -------------------------------------------------------------
REDIS_PASSWORD=infrapilot

# -------------------------------------------------------------
# BACKEND
# -------------------------------------------------------------
ENV=production

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# -------------------------------------------------------------
# FRONTEND
# -------------------------------------------------------------
# API URL as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# For production behind nginx:
# NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1

# -------------------------------------------------------------
# NGINX / REVERSE PROXY
# -------------------------------------------------------------
# Ports for nginx (change if 80/443 are in use)
HTTP_PORT=80
HTTPS_PORT=443

# -------------------------------------------------------------
# SSL / LET'S ENCRYPT
# -------------------------------------------------------------
# Email for Let's Encrypt certificate notifications
LETSENCRYPT_EMAIL=admin@your-domain.com

# Use staging server for testing (set to false for production)
LETSENCRYPT_STAGING=true

# -------------------------------------------------------------
# DOCKER IMAGE VERSION
# -------------------------------------------------------------
VERSION=latest

# -------------------------------------------------------------
# OPTIONAL: EXTERNAL PROXY MODE
# -------------------------------------------------------------
# Uncomment to disable managed nginx and use your own proxy
# PROXY_MODE=external

# -------------------------------------------------------------
# BUILD & PUBLISH (only used by scripts/build-and-publish.sh)
# -------------------------------------------------------------
# Registry push credentials. The publish script logs in with these before
# pushing, so you don't need a manual `docker login`.
#   Docker Hub: create an access token at hub.docker.com → Account → Security
#   GHCR:       a GitHub PAT (classic) with the write:packages scope
# DOCKERHUB_USERNAME=infrapilothq
# DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxx
# GHCR_USERNAME=your-github-username
# GHCR_TOKEN=ghp_xxxxxxxxxxxx
